[Unit]
Description=MFZ_PA — always-on Claude Code session bridged to Discord
Documentation=https://claude.com/plugins/discord
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
Group=root
WorkingDirectory=/root/mfz-pa
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.bun/bin
EnvironmentFile=-/etc/mfz-pa/env

# Start a detached tmux session running Claude Code with the Discord channel.
# The trailing `exec bash` keeps the pane open if claude exits, so we can
# inspect what happened on `tmux attach -t mfz-pa`.
ExecStart=/usr/bin/tmux new-session -d -s mfz-pa -c /root/mfz-pa \
  "claude --channels plugin:discord@claude-plugins-official; exec bash"

ExecStop=/usr/bin/tmux kill-session -t mfz-pa

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target

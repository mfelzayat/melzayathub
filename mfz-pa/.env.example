# MFZ_PA environment variables.
# Production copy lives at /etc/mfz-pa/env (chmod 600), loaded by the systemd unit.
# This file is a template — do not commit real secrets.

# Discord bot token from https://discord.com/developers/applications (Bot > Reset Token).
DISCORD_BOT_TOKEN=

# Long-lived subscription OAuth token.
# Generate with `claude setup-token` on the VPS — requires a Claude.ai Pro/Max subscription.
# Do NOT set ANTHROPIC_API_KEY — it would override this and trigger metered billing.
CLAUDE_CODE_OAUTH_TOKEN=

# Comma-separated Discord user IDs allowed to talk to the bot.
# Enable Developer Mode in Discord, right-click your name, "Copy User ID".
ALLOWED_DISCORD_IDS=

# Optional: override default model. Defaults to claude-sonnet-4-6.
# MFZ_PA_MODEL=claude-opus-4-7
